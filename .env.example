# Mapbox Access Token
# Preferred: set MAPBOX_ACCESS_TOKEN for server-side rendering (works in Vercel preview deployments
# without being baked into the client bundle at build time).
MAPBOX_ACCESS_TOKEN=

# Legacy fallback: NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN is baked into the client bundle at build time.
# Use this only if you need the token available in fully static / client-only contexts.
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Database (Neon Postgres + PostGIS)
DATABASE_URL=

# Used for migrations. Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=

# Comma-separated database endpoint ids that scripts/seed-clerk-ids.ts must
# never write to — i.e. production. The script FAILS CLOSED: if this is unset it
# refuses to run at all, so an absent value disables the script, never the guard.
#
# This file only covers local development. The variable must ALSO be set in
# Vercel (Production, Preview and Development) or the script will refuse to run
# there — including from the build.
PROTECTED_DB_HOSTS=

# Cursor Pagination
# HMAC key used to sign opaque pagination cursors (lib/api/pagination.ts).
# Any non-empty value works locally; use a real secret in deployed environments.
# Without it, list endpoints degrade to unpaginated results.
CURSOR_SECRET=

# Clerk Authentication
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Webhook Secret (for syncing user events to our DB)
# Set up at https://dashboard.clerk.com → Webhooks
CLERK_WEBHOOK_SECRET=

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# PostHog Product Analytics
# The project API key is browser-safe and intentionally uses NEXT_PUBLIC_.
NEXT_PUBLIC_POSTHOG_KEY=
# Use https://eu.i.posthog.com for EU-hosted PostHog projects.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Monitoring
# The DSN is browser-safe and intentionally uses NEXT_PUBLIC_.
# Set this in EVERY environment you want reports from — including Preview.
# Without it the SDK initializes as a no-op and errors are silently dropped.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: override the environment name shown in Sentry.
# Defaults to VERCEL_ENV (production / preview) or "development" locally.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Build-time only: uploads source maps so stack traces are readable.
# REQUIRED SCOPES: project:releases, project:read, org:read.
# A token missing project:releases fails with HTTP 403 and every stack trace in
# Sentry stays as unreadable minified output.
SENTRY_AUTH_TOKEN=

# Knock Notification Service (knock.app)
# Server-side API key for triggering workflows
KNOCK_API_KEY=
# Webhook signing key for verifying Knock webhooks
KNOCK_SIGNING_KEY=
