# Mapbox Access Token
# Preferred: set MAPBOX_ACCESS_TOKEN for server-side rendering (works in Vercel preview deployments
# without being baked into the client bundle at build time).
MAPBOX_ACCESS_TOKEN=

# Legacy fallback: NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN is baked into the client bundle at build time.
# Use this only if you need the token available in fully static / client-only contexts.
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Clerk Authentication
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk Webhook Secret (for syncing user events to our DB)
# Set up at https://dashboard.clerk.com → Webhooks
CLERK_WEBHOOK_SECRET=

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
