legacy-peer-deps=true

# @texturehq/edges-explore is published to BOTH GitHub Packages and npmjs,
# but the npmjs side currently publishes as scope-default (restricted), so
# unauthenticated installs hit a 404. Until the publish workflow is fixed
# to use `--access public` on npmjs, resolve from GHPR — every developer +
# CI environment needs a GITHUB_TOKEN with `read:packages` scope on the
# TextureHQ org to install.
@texturehq:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
