{
  "installCommand": "npm install",
  "buildCommand": "npm run prebuild && next build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/keep-alive",
      "schedule": "*/4 7-19 * * 1-5"
    },
    {
      "path": "/api/cron/notification-retry",
      "schedule": "*/30 * * * *"
    }
  ]
}
