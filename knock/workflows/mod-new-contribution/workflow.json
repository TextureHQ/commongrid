{
  "categories": [
    "moderation_queue"
  ],
  "description": "Sent to moderators when a new community contribution is submitted for review.",
  "name": "New Contribution for Review",
  "steps": [
    {
      "channel_key": "postmark",
      "channel_type": "email",
      "ref": "email_1",
      "template": {
        "settings": {
          "layout_key": "default"
        },
        "subject": "New {{ data.entityType }} edit awaiting review",
        "visual_blocks@": "email_1/visual_blocks.json"
      },
      "type": "channel"
    },
    {
      "channel_key": "in-app",
      "channel_type": "in_app_feed",
      "ref": "in_app_1",
      "template": {
        "action_url": "{{ data.contributionUrl }}",
        "markdown_body@": "in_app_1/markdown_body.md"
      },
      "type": "channel"
    }
  ],
  "trigger_frequency": "every_trigger",
  "__readonly": {
    "key": "mod-new-contribution",
    "active": true,
    "valid": true
  },
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
